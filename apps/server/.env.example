# SQLite database file path (required).
HERMANO_DATABASE_PATH=/data/hermano.sqlite3

# Port the server listens on.
HERMANO_PORT=8080

# The externally-reachable origin Hermano is served at, e.g.
# https://hermano.example.com. Used to build links back into the dashboard
# (Pushover's "View in Hermano" link, OIDC's redirect default). Leave unset
# and those links fall back to this server's own http://127.0.0.1:<port>
# origin, which only works from the server itself (also editable from the
# Settings page).
# HERMANO_PUBLIC_URL=

# Optional bearer-token check on POST /api/webhook. Leave unset to accept
# any request — Alertmanager can't do OIDC, so this is the only auth
# available for the webhook endpoint. If set, configure Alertmanager's
# webhook_configs with `authorization: { type: Bearer, credentials: <value> }`.
# HERMANO_WEBHOOK_SHARED_SECRET=

# Hermes' Runs API. Leave HERMANO_HERMES_AGENT_URL unset to disable dispatch
# entirely — alerts are still ingested/tracked, just never forwarded.
# HERMANO_HERMES_AGENT_URL=http://hermes-api.ai.svc.cluster.local:8642
# HERMANO_HERMES_AGENT_API_KEY=
HERMANO_HERMES_AGENT_DISPATCH_TIMEOUT_MS=1800000
HERMANO_HERMES_POLL_INTERVAL_MS=3000

# Alertmanager's own read API (not the webhook receiver above) — leave
# HERMANO_ALERTMANAGER_URL unset to disable this entirely and rely solely on
# webhook delivery. When set, Hermano periodically double-checks its active
# alerts against GET /api/v2/alerts and resolves any that Alertmanager no
# longer lists, so a single dropped "resolved" webhook can't leave an alert
# stuck firing forever.
# HERMANO_ALERTMANAGER_URL=http://alertmanager.monitoring.svc.cluster.local:9093
HERMANO_ALERTMANAGER_RECONCILE_INTERVAL_MS=300000

LOG_LEVEL=info

# Absolute path to the built web SPA (apps/web/dist). Set in production so
# this server also serves the frontend; leave unset in dev, where the Vite
# dev server serves it instead.
# STATIC_WEB_DIR=

# OIDC: leave all unset for single-user mode (no login). If any is set, all
# three (plus SESSION_SECRET) are required.
# OIDC_ISSUER_URL=https://auth.example.com
# OIDC_CLIENT_ID=hermano
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=
# SESSION_SECRET=

# Pushover — leave both unset to disable notifications entirely. When set,
# Hermano notifies you about alerts matching no delegation rule (firing and
# resolved), delegations that failed/timed out, and alerts that fire again
# after previously being marked fixed. Notifying on a *successful* fix is
# off by default (all of these are also editable from the Settings page).
# HERMANO_PUSHOVER_API_TOKEN=
# HERMANO_PUSHOVER_USER_KEY=
# HERMANO_PUSHOVER_NOTIFY_ON_COMPLETED=false
